# Never put secrets or personal documents into the image.
**/.env
**/.env.*
credentials*
*.credentials
registration/
*passport*.jpg
*passport*.jpeg
*passport*.png
*passport*.pdf

# Build and local state
.git
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/var
mobile/dist
mobile/.expo
.claude
# docs stay out, except what the trust center reads: the saved fuzzing report (GET /api/security/fuzz-results), and
# the evidence log with its on-chain anchor record (GET /api/security/anchor)
docs/**
!docs/evidence/fuzzing_report.json
!docs/evidence/sandbox_operation_log.jsonl
!docs/evidence/anchor_record.json
# private keys never go into an image
*.pem
*.key
